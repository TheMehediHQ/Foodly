# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas credentials
# The server reads DB_USER/DB_PASS (falls back to NAME/PASS).
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=foodsdb
DB_CLUSTER=cluster0.onrfrlh.mongodb.net

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# CORS allow-list (comma-separated, used for reference in production)
FRONTEND_PROD_URL=https://foodly.mehedi-hasan.me
FRONTEND_DEV_URL=http://localhost:5173

# Firebase Auth & RBAC
FIREBASE_PROJECT_ID=food-garden-bd
INITIAL_ADMIN_EMAIL=admin@mehedi-hasan.me
